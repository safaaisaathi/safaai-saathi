{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://safaaisaathi.contracts/collections/notice.schema.json",
  "title": "Notice",
  "description": "A one-way message from the office to a van, a ward, or everyone. PRD-2 section 3.3.",
  "type": "object",
  "x-docId": "auto",
  "x-writes": ["adminpanel via publishNotice"],
  "x-reads": ["driverapp", "userapp", "adminpanel"],
  "properties": {
    "targetType": {
      "$ref": "https://safaaisaathi.contracts/enums.json#/$defs/notice.targetType"
    },
    "targetId": {
      "type": ["string", "null"],
      "description": "The van id or the ward id. Null or empty for targetType = all."
    },
    "message": {
      "type": "string",
      "minLength": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "createdBy": {
      "type": "string",
      "description": "The staff doc id."
    }
  },
  "required": ["targetType", "message", "createdAt", "createdBy"]
}
