{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://safaaisaathi.contracts/collections/.composed/complaint.schema.json",
  "title": "Complaint (composed)",
  "description": "Generated by 08-tools/build-schemas.ts from the raw schema plus registered extensions. Do not edit by hand. Regenerate with: node 08-tools/build-schemas.ts",
  "type": "object",
  "x-docId": "auto",
  "x-writes": [
    "userapp: create",
    "driverapp: status, resolvedAt (D4 scope only)",
    "adminpanel: via setComplaintStatus",
    "platform functions: mergedInto, escalationLevel"
  ],
  "x-reads": [
    "userapp: own only, scoped by the deviceId claim",
    "driverapp: wards in the current trip only",
    "adminpanel: within the live staff ward scope"
  ],
  "required": [
    "ticketId",
    "deviceId",
    "category",
    "wardId",
    "createdAt",
    "status",
    "escalationLevel"
  ],
  "properties": {
    "ticketId": {
      "type": "string",
      "pattern": "^PMH-[0-9]{8}-[0-9]{4}$",
      "description": "The human id. Format PMH-YYYYMMDD-NNNN."
    },
    "deviceId": {
      "type": "string",
      "description": "The citizen's install id. THEIR ONLY KEY. The read rule compares it against the deviceId claim. Never a client parameter."
    },
    "category": {
      "type": "string",
      "title": "Complaint category",
      "enum": [
        "garbage_dump",
        "open_gutter",
        "missed_collection",
        "other"
      ]
    },
    "photoUrl": {
      "type": "string",
      "description": "Storage path complaints/{complaintId}/photo.jpg. Compressed under 500 KB."
    },
    "location": {
      "type": "object",
      "description": "Where the citizen saw the problem.",
      "properties": {
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lng": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      },
      "required": [
        "lat",
        "lng"
      ]
    },
    "wardId": {
      "type": "string"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "description": "A SERVER timestamp. The complaint's age drives escalation, so a client clock would break escalation."
    },
    "status": {
      "type": "string",
      "title": "Complaint status",
      "enum": [
        "received",
        "assigned",
        "resolved",
        "escalated"
      ]
    },
    "assignedTo": {
      "type": "string",
      "description": "The staff doc id this complaint is assigned to."
    },
    "escalationLevel": {
      "type": "integer",
      "title": "Escalation level",
      "enum": [
        0,
        1,
        2
      ]
    },
    "resolvedPhotoUrl": {
      "type": "string",
      "description": "Storage path complaints/{complaintId}/resolved.jpg."
    },
    "resolvedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "mergedInto": {
      "type": [
        "string",
        "null"
      ],
      "description": "The ticket this one was merged into. Null normally. Set by mergeDuplicates."
    },
    "note": {
      "type": "string",
      "description": "Free text from the office."
    }
  }
}
