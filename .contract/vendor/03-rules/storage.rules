rules_version = '2';
// Safai Sathi driver-app dev rules for Cloud Storage — mirrors
// firestore.rules: only signed-in app users, only media uploads the
// driver flows will need (photos LGTM ticket). TIGHTENED at the
// integration/pentest sweep.
service firebase.storage {
  match /b/{bucket}/o {
    // Driver media: each driver writes only inside their own folder;
    // app users may read seeded assets (e.g. mascot, route maps).
    match /apps/{appId}/media/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 20 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
